[Unit]
Description=IG Harness OSS
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ig-harness
EnvironmentFile=/opt/ig-harness/apps/worker/.env
ExecStart=/usr/bin/pnpm start
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
